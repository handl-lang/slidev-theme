{
  "name": "slidev-theme-handl",
  "type": "module",
  "version": "0.1.0",
  "description": "handl — a Slidev theme in the handl docs look: Source Sans 3 / Source Code Pro, an oklch green ramp on black & white, square corners and the `>>>` prompt motif.",
  "keywords": [
    "slidev-theme",
    "slidev",
    "handl",
    "terminal",
    "green"
  ],
  "license": "MIT",
  "author": "handl-lang",
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "global-top.vue",
    "global-bottom.vue",
    "uno.config.ts",
    "example.md"
  ],
  "homepage": "https://github.com/handl-lang/slidev-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/handl-lang/slidev-theme"
  },
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=0.53.0"
  },
  "scripts": {
    "dev": "slidev example.md --open",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^53.0.0"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "playwright-chromium": "^1.63.0"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Source Sans 3",
        "serif": "Source Sans 3",
        "mono": "Source Code Pro",
        "weights": "400,600,700"
      }
    }
  }
}
