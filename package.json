{
  "name": "slidev-theme-lfds",
  "type": "module",
  "version": "0.1.0",
  "description": "LFDS — a retro-terminal Slidev theme: Roboto type, a phosphor palette, augmented corners and dashed links.",
  "keywords": [
    "slidev-theme",
    "slidev",
    "lfds",
    "retro",
    "terminal",
    "augmented-ui"
  ],
  "license": "MIT",
  "author": "Luis Emidio",
  "homepage": "https://github.com/luisfuturist/slidev-theme-lfds",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisfuturist/slidev-theme-lfds"
  },
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=0.53.0"
  },
  "scripts": {
    "dev": "slidev example.md --open",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^53.0.0",
    "augmented-ui": "^2.0.0"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "playwright-chromium": "^1.63.0"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Roboto",
        "serif": "Roboto Condensed",
        "mono": "Roboto Mono"
      }
    }
  }
}
